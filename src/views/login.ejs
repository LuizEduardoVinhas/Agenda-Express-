<%- include('include/head')%>
  <%- include('include/nav')%>

    <div class="container">
      <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
          <h1 class="display-1 text-center"> Login/Entrar </h1>
          <p class="text-center lead">Faça o login ou crie sua conta abaixo </p>
          <%-include('include/message')%>
          
          <div class="row">

            <div class="col-lg">

              <h4>Faça seu cadastro</h4>
              <p>Se você não tem conta, preencha o formulario abaixo</p>

              <form action="/login/register" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                  <label>Seu E-mail:</label>
                  <input type="email" class="form-control" name="email">
                </div>
                <div class="form-group">
                  <label>Sua senha:</label>
                  <input type="password" class="form-control" name="senha">
                </div>
                <button type="submit" class="btn btn-primary">Cadastro</button>
              </form>
            </div>

            <div class="col-lg">
              <h4>Faça seu login</h4>
              <p>Se você já uma tem conta, preencha o formulario abaixo</p>

              <form action="/login/login" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                  <label>Seu E-mail:</label>
                  <input type="email" class="form-control" name="email">
                </div>
                <div class="form-group">
                  <label>Sua senha:</label>
                  <input type="password" class="form-control" name="senha">
                </div>
                <button type="submit" class="btn btn-primary">Entrar</button>
              </form>

            </div>

          </div>
        </div>

        <div class="col-lg-2"></div>
      </div>
    </div>
    <%- include('include/footer')%>