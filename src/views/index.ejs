<%- include('include/head')%>
  <%- include('include/nav')%>

    <div class="container">
      <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
          <h1 class="display-1 text-center"> Agenda </h1>
          <p class="text-center lead">Seus contatos estão abaixo: </p>

          <%- include('include/message')%>

          <% if(contatos.length === 0) { %>
            <p class="text-center lead" > Nenhum contato registrado </p>
          <% } else { %>
            <div class="responsive-table">
              <table class="table my-3">
                <% contatos.forEach(contato=> { %>
                  <tr>
                    <td>
                      <%= contato.nome %>
                    </td>
                    <td>
                      <%= contato.sobrenome %>
                    </td>
                    <td>
                      <%= contato.telefone %>
                    </td>
                    <td>
                      <%= contato.email %>
                    </td>
                    <td><a href="/index/contato/<%= contato._id %>" class="btn btn-primary">Editar</a></td>
                    <td><a href="/index/contato/delete/<%= contato._id %>" class="btn btn-danger">Deletar</a></td>
                  </tr>
                <% }); %>
              </table>
            </div>
          <% } %>
        </div>

        <div class="col-lg-2"></div>
      </div>
    </div>
    <%- include('include/footer')%>