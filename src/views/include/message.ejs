<% if (errors.length > 0) { %>

<div class="row mt-3">
    <div class="col">
        <div class="alert alert-danger"> 
            <% errors.forEach(function(erro) { %>
                <%= erro %> <br> 
            <% }); %>
        </div>
    </div>
</div>

<% } %>
<% if (success.length > 0) { %>

<div class="row mt-3">
    <div class="col">
        <div class="alert alert-success"> 
            <% success.forEach(function(erro) { %>
                <%= erro %> <br> 
            <% }); %>
        </div>
    </div>
</div>

<% } %>